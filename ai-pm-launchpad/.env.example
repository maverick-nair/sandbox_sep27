# Required in production
PUBLIC_URL=https://launchpad.example.com        # HTTPS origin learners use; enables Secure cookies and HSTS
ANTHROPIC_API_KEY=                               # KNOLSKAPE's key. Without it the app runs on the scripted backup engine
ADMIN_EMAIL=admin@knolskape.com                  # first administrator, created on first start
ADMIN_PASSWORD=                                  # 12+ characters; rotate after first sign-in
# Optional
PORT=8080
DATA_FILE=/data/launchpad.db                     # SQLite file; mount a persistent volume and back it up
CLAUDE_MODEL=claude-opus-5
CLAUDE_PERSONA_EFFORT=low                        # stakeholder replies: low keeps conversations responsive
CLAUDE_ASSESS_EFFORT=high                        # assessment quality
CLAUDE_FALLBACKS=default                         # server-side fallback model if a request is declined; "off" to disable
DAILY_TOKEN_BUDGET=600000                        # per learner per UTC day; over budget falls back to scripted replies
REVIEW_SAMPLE_RATE=0.2                           # share of Claude-scored attempts sent to the blind human review queue
RETENTION_DAYS=365                               # conversation transcripts are deleted after this; scores are kept
SESSION_DAYS=14
# Single sign-on (OpenID Connect: Azure AD / Entra ID, Okta, Google Workspace)
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=https://launchpad.example.com/api/auth/oidc/callback
# xAPI to the client's LMS / LRS
LRS_ENDPOINT=
LRS_AUTH=                                        # e.g. "Basic base64(key:secret)"
